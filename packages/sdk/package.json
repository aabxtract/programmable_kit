{
  "name": "@programmable-devkit/sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for the Programmable Market API on Robinhood Chain (chainId 4663)",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
